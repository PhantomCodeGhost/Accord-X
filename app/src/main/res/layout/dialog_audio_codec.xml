<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="32dp"
    android:paddingBottom="8dp"
    android:paddingHorizontal="24dp">

    <ImageView
        android:id="@+id/codec_icon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:src="@drawable/apple_lossless_seeklogo"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/codec_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Hi-Res Lossless"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/codec_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:text="24-bit/88.2 kHz ALAC"
        android:textColor="#A0A0A5"
        android:textSize="15sp" />

</LinearLayout>
