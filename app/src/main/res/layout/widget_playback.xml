<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="true"
    android:clipToPadding="true">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_bg" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_cover" />

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignTop="@id/widget_album_art"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="1dp"
            android:src="@drawable/ic_music_note_small"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:id="@+id/widget_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/widget_album_art"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@id/widget_app_icon"
            android:layout_toEndOf="@id/widget_album_art"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Not Playing"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_toEndOf="@id/widget_album_art"
            android:background="#1AFFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/widget_album_art"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nowplaying_mp_frewind"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="20dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nowplaying_mp_play"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="20dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nowplaying_mp_fforward"
                android:tint="#FFFFFF" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>
